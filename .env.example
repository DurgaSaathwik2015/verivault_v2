# Copy to .env (or set in your host). None of these are required locally.
SECRET_KEY=            # long random string; if empty a random one is generated into instance/secret.key
COOKIE_SECURE=false    # true when served over HTTPS
TRUST_PROXY=0          # 1 behind Render/Heroku-style proxies
SEED_DEMO=0            # 1 creates the demo users and sample documents
VERIVAULT_DEMO=0       # 1 lets any account click "Become an owner" (demo only!)
DATA_DIR=              # absolute path for the database + uploads (persistent disk)
DATABASE_URL=          # defaults to SQLite in DATA_DIR / instance
